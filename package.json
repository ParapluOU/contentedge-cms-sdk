{
  "name": "@codesocietyou/contentedge-cms-sdk",
  "private": false,
  "version": "1.0.6",
  "description": "A lightweight, framework-agnostic TypeScript client for the ContentEdge headless CMS with API key authentication and optional React Query integration.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version:apply": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "content",
    "cms",
    "sdk",
    "typescript",
    "headless-cms",
    "react-query",
    "tanstack"
  ],
  "author": "ContentEdge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ParapluOU/contentedge-cms-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ParapluOU/contentedge-cms-sdk/issues"
  },
  "homepage": "https://github.com/ParapluOU/contentedge-cms-sdk#readme",
  "engines": {
    "node": ">=24.13.1",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "axios": "^1.13.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.90.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.100.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
